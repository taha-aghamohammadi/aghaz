# Supabase — copy to .env and fill in values. Never commit .env.

# Client (Vite)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
VITE_SUPABASE_PROJECT_ID=your-project-id
VITE_SITE_URL=http://localhost:8080

# Server
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_PROJECT_ID=your-project-id
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...
# For npm run db:push — Database password from Dashboard → Settings → Database
# SUPABASE_DB_PASSWORD=
# SUPABASE_DB_REGION=ap-northeast-2
SITE_URL=http://localhost:8080

# OTP / SMS (Phase B)
KAVENEGAR_API_KEY=
KAVENEGAR_OTP_TEMPLATE=verify
OTP_DEMO_MODE=true
VITE_OTP_DEMO_MODE=true

# Payment (Phase B — Zarinpal)
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=true

# Smart door (Phase F)
DOOR_DEVICE_API_KEY=

# Telegram (Phase E)
TELEGRAM_BOT_TOKEN=
